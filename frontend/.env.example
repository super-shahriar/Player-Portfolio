# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX).
# Production only — intentionally left unset in local frontend/.env so
# GTM never loads during development. Set this in your hosting platform's
# environment config, not in a committed file. Create a container at
# https://tagmanager.google.com if you don't have one yet.
NEXT_PUBLIC_GTM_ID=
